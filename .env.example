# Port the API listens on. Must match the proxy target in Frontend/vite.config.ts.
PORT=4000

# Comma-separated extra origins allowed by CORS (localhost:5173 is the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# How long a result stays in the in-memory cache. Only matters without DATABASE_URL.
CACHE_TTL_MINUTES=30

# 0 = no cap; every sort order is walked until Google stops paginating.
# Google serves ~150 reviews per page and throttles harder the deeper you go, so an uncapped
# fetch on a busy app is bounded by the timeout below rather than by a count.
MAX_REVIEWS=0

# Wall clock for a single fetch — roughly 10k reviews per minute; going much past ~5 buys
# progressively less as throttling builds. Whatever was collected when it expires is kept.
# 0 disables it.
FETCH_TIMEOUT_MINUTES=1

# Postgres connection string (Neon, Supabase, Render Postgres...).
# With it, an app is scraped once then served from the database instantly, and refreshes only
# pull reviews that are new.
# Empty = no persistence: the app still works, it just re-scrapes every fetch.
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
